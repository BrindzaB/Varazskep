generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Models ────────────────────────────────────────────────────────────────

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String? // Default/fallback storefront image
  active      Boolean   @default(true)
  // Storefront category tab for local products (e.g. "Bögrék", "Párnák").
  // Admin-editable, independent of mockupType. null → shown only under "Összes".
  category    String?
  // Designer template key (code-side, see lib/designer/mockupConfig.ts).
  // null = product is sellable but NOT designable. Does NOT drive storefront display.
  mockupType  String?
  variants    Variant[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Variant {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  color       String
  size        String
  // Per-colour storefront photo (admin-uploaded). Managed per colour: all size
  // variants of the same colour share the same image. null → falls back to
  // Product.imageUrl. Mirrors how Malfini variants carry their own images.
  imageUrl    String?
  price       Int // price in HUF (forint), stored as integer — no decimals
  stock       Int     @default(0)
  // Gross package weight in grams, used to source the Kvikk parcel weight.
  // Null → falls back to a default (see lib/kvikk/weight.ts + lib/services/shipping.ts).
  weightGrams Int?
  orders      Order[] // LEGACY single-item orders — new orders link via OrderItem
  orderItems  OrderItem[]
}

model Clipart {
  id         String   @id @default(cuid())
  name       String
  category   String
  svgUrl     String // Supabase Storage public URL (clipart bucket — permanent)
  darkSvgUrl String? // Dark-background variant URL — null if no dark version exists
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Design {
  id         String   @id @default(cuid())
  canvasJson Json // Fabric.js serialized canvas state — stored as JSONB
  svgUrl     String? // S3 URL of the exported SVG, nulled after 45 days
  // PNG snapshot of the designer canvas (product mockup + design) as the customer
  // saw it, captured client-side at add-to-cart. Null for Malfini designs (tainted
  // canvas) and pre-feature orders. Shown in the admin order detail.
  previewUrl String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime // set to createdAt + 45 days at creation time
  order      Order? // LEGACY single-item orders
  orderItem  OrderItem?
}

// Admin-editable pricing parameters. Key/value so new knobs need no migration.
// Read through lib/pricing/settings.ts, which supplies defaults for missing rows —
// an empty table is a valid state and yields the documented defaults.
model PricingSetting {
  key       String   @id // see PRICING_SETTING_KEYS in lib/pricing/settings.ts
  value     String // numeric values stored as text; parsed + validated on read
  updatedAt DateTime @updatedAt
}

// Admin-editable shop settings that are not pricing (e.g. the order notification address).
// Key/value like PricingSetting; read through lib/services/shopSettings.ts, which supplies
// defaults for missing rows.
model ShopSetting {
  key       String   @id // see SHOP_SETTING_KEYS in lib/services/shopSettings.ts
  value     String
  updatedAt DateTime @updatedAt
}

// Manual selling price for one Malfini SKU, overriding the computed cost×árrés×VAT price.
// Needed because Malfini's implied retail markup is not uniform: most products sit near
// 1.55× cost, but some reach 3.08×, where a flat árrés prices well under the market.
// Sparse by design — only the SKUs an admin actually overrides get a row.
model PriceOverride {
  productSizeCode String   @id // 7-char Malfini SKU — globally unique
  productCode     String // 3-char product code, for per-product listing and bulk edits
  priceHuf        Int // gross HUF, shown to the customer verbatim
  updatedAt       DateTime @updatedAt

  @@index([productCode])
}

// Malfini products offered without browsing the whole catalogue: the designer's product
// picker and the order form (megrendelő lap). Admin-editable; position = display order.
model FeaturedMalfiniProduct {
  productCode String @id // 3-char Malfini product code
  position    Int
}

// Products highlighted in the "Népszerű termékek" box on the Termékek page. Admin-editable,
// at most 10; position = display order. key = "malfini:<code>" | "local:<productId>", so one
// ordered list mixes both sources. A key whose product is gone or inactive is skipped.
model PopularProduct {
  key      String @id
  position Int
}

// Pictogram shown above a local product category on the Termékek page. category matches
// Product.category; icon is a key from lib/shop/categoryIcons.ts. No row → default icon.
model CategoryIcon {
  category String @id
  icon     String
}

model Order {
  id                    String         @id @default(cuid())
  // Where the order came from. WEBSHOP orders are paid by Stripe; ORDER_FORM orders are
  // requests with no price or payment — the shop settles them with the customer later.
  channel               OrderChannel   @default(WEBSHOP)
  stripeSessionId       String?        @unique // null for ORDER_FORM orders
  status                OrderStatus    @default(PENDING)
  customerNote          String? // ORDER_FORM: the customer's free-text order description
  attachments           OrderAttachment[] // ORDER_FORM: files uploaded with the order
  // The ordered products, one row per cart line. Empty on legacy orders.
  items                 OrderItem[]
  // LEGACY single-item fields: orders created before OrderItem stored their one product
  // here (and lost every further cart line). Read-only now — new orders leave them
  // empty; lib/orders/lines.ts presents both shapes as line items.
  variantId             String?
  variant               Variant?       @relation(fields: [variantId], references: [id])
  productSizeCode       String? // 7-char SKU e.g. "M150XM0"
  productCode           String? // 3-char product code e.g. "150"
  productName           String         @default("")
  colorName             String         @default("")
  sizeName              String         @default("")
  designId              String?        @unique
  design                Design?        @relation(fields: [designId], references: [id])
  // Customer info — retained 8 years per Hungarian tax law (Számviteli törvény)
  customerName          String
  customerEmail         String
  customerPhone         String? // recipient phone — needed to create the Kvikk shipment
  shippingAddress       Json? // { address, city, postalCode, country } — null for ORDER_FORM
  totalAmount           Int? // in HUF (includes shipping cost) — null for ORDER_FORM (unpriced)
  gdprConsent           Boolean
  // Shipping method and cost
  shippingMethod        ShippingMethod @default(MPL_HOME_DELIVERY)
  shippingCost          Int            @default(0) // in HUF
  // Foxpost locker details — null for home delivery
  pickupPointId         String? // Foxpost OperatorCode (LEGACY — old Foxpost flow only)
  pickupPointName       String? // human-readable point name (reused by Kvikk for display)
  pickupPointAddress    String? // formatted point address for display (reused by Kvikk)
  // Kvikk shipping (Phase 8) — null on legacy orders created before the Kvikk migration.
  shippingCourier       String? // Kvikk courier slug: mpl | foxpost | packeta | famafutar | dpd | gls
  deliveryType          DeliveryType? // home delivery vs delivery point
  deliveryPointType     String? // Kvikk long code sent on create, e.g. "gls_locker"
  deliveryPointId       String? // Kvikk/courier delivery point id
  parcelWeightGrams     Int? // total parcel weight (g) captured at checkout — used when creating the shipment
  kvikkTrackingNumber   String? // Kvikk tracking number (e.g. "M123412341234")
  courierTrackingNumber String? // courier's own tracking number
  kvikkShipmentId       String? // Kvikk internal shipment id (for management/label re-fetch)
  deliveryNoteId        String? // set once the shipment is on a delivery note (courier pickup requested)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

// One ordered product line. The product identity is denormalized (name/colour/size)
// for 8-year retention even if the product is later removed or renamed.
model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position        Int // 0-based cart line order — cuids are not a reliable sort key
  // Local products (mugs, etc.) — null for Malfini lines
  variantId       String?
  variant         Variant? @relation(fields: [variantId], references: [id])
  // Malfini products (clothing) — null for local lines
  productSizeCode String? // 7-char SKU e.g. "M150XM0"
  productCode     String? // 3-char product code e.g. "150"
  productName     String
  colorName       String
  sizeName        String
  quantity        Int
  // Both null on ORDER_FORM lines, which are priced later by the shop.
  unitPriceHuf    Int? // gross product price per piece, as charged
  printFeeHuf     Int? // gross print fee per piece, as charged (0 = no design)
  // Design (optional — set for lines created in the designer)
  designId        String?  @unique
  design          Design?  @relation(fields: [designId], references: [id])

  @@index([orderId])
}

// A file the customer uploaded with an ORDER_FORM order (artwork, logo, brief). Stored in
// the private order-files bucket; the admin downloads it through a short-lived signed URL.
model OrderAttachment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storagePath String   @unique // object path inside the order-files bucket
  fileName    String // original file name, for display and download
  contentType String?
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([orderId])
}

// ─── Enums ─────────────────────────────────────────────────────────────────

// LEGACY — old Foxpost/MPL flow. Retained for historical orders; new orders use
// `shippingCourier` + `deliveryType` (Kvikk). Do not use for new orders.
enum ShippingMethod {
  FOXPOST_LOCKER
  MPL_HOME_DELIVERY
}

// Kvikk delivery type — whether the parcel goes to the customer's address or to a point.
enum DeliveryType {
  HOME_DELIVERY
  DELIVERY_POINT
}

enum OrderChannel {
  WEBSHOP // cart + Stripe checkout
  ORDER_FORM // megrendelő lap — request without price or payment
}

enum OrderStatus {
  REQUESTED // ORDER_FORM order received, not yet processed
  PENDING // Stripe session created, payment not yet confirmed
  PAID // Stripe webhook received — order is now real
  IN_PRODUCTION // Admin has started processing
  SHIPPED // Package sent
  COMPLETE // Delivered
  RETURNED // Shipment returned to sender (Kvikk `returned` event)
  CANCELLED // Cancelled before or after production
}
